# ============================================================
# .gitignore - gerado por limpar-git.ps1
# ============================================================

# Dependencias
node_modules/

# Build
dist/

# Logs da aplicacao
logs/

# Logs do nginx (preserva a configuracao do nginx)
nginx/logs/

# Arquivos que NAO devem ir para o Git
context.py
projeto_exportado.txt

# Arquivos de ambiente
.env
.env.*
!.env.example

# Cobertura de testes
coverage/

# Cache do TypeScript
*.tsbuildinfo

# Sistema operacional / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Backups locais gerados por este script
.gitignore.bak